tutorial panel/notifications maybe.\n\nNeed ensure game full viewport and visually striking. Intro splash overlay:\n- background game scene paused blurred? We can start scene behind overlay and camera slowly orbit. Overlay with big title \"STARCRAFT 3D\", subtitle \"FRONTIER SIEGE\", \"Terran Dominion vs. Krag Swarm\", instructions, button \"DEPLOY\". Maybe create a stylized title with CSS gradient. Play button.\n- User can click deploy; auto start capture likely clicks button? Capture selectors default maybe auto start behavior looks for button? Let's inspect capture-start.","native":{"reasoningField":"reasoning_content"},"time":{"created":1793936033239,"completed":1793936097361}},{"type":"tool","id":"call_c7b4790b95704c9d8363cb47","name":"shell","executed":false,"state":{"status":"completed","input":{"command":"sed -n '1,240p' \"$RUNTIME_DIR/scripts/capture-start.mjs\"; grep -R \"auto-start\\|CAPTURE_START\" -n \"$RUNTIME_DIR/scripts\" | head -20"},"content":[{"type":"text","text":"// Start gameplay once without guessing between multiple controls or following links.\nexport async function startForCapture(page, { enabled = true, selector = '', timeout = 3000 } = {}) {\n  if (!enabled) return { clicked: false, reason: 'disabled' }\n  const candidate = selector\n    ? page.locator(selector)\n    : page.locator('button, input[type=\"button\"], input[type=\"submit\"], [role=\"button\"]')\n  const deadline = Date.now() + timeout\n  do {\n    const matches = []\n    for (const control of await candidate.all()) {\n      if (!await control.isVisible() || !await control.isEnabled()) continue\n      const eligible = await control.evaluate((element, explicit) => {\n        if (element.closest('a[href], form') || element.getAttribute('aria-disabled') === 'true') return false\n        if (explicit) return true\n        const label = element.getAttribute('aria-label') || element.value || element.textContent || ''\n        return /^(?:start|play)(?:\\s+(?:game|now))?$/i.test(label.trim())\n      }, Boolean(selector))\n      if (eligible) matches.push(control)\n    }\n    if (matches.length > 1) return { clicked: false, reason: 'ambiguous' }\n    if (matches.length === 1) {\n      try { await matches[0].click({ trial: true, timeout: 2000 }) }\n      catch (error) {\n        if (error.name === 'TimeoutError') return { clicked: false, reason: 'not-actionable' }\n        throw error\n      }\n      await matches[0].click({ timeout: 2000, noWaitAfter: true })\n      return { clicked: true }\n    }\n    if (Date.now() >= deadline) break\n    await page.waitForTimeout(Math.min(200, Math.max(0, deadline - Date.now())))\n  } while (Date.now() <= deadline)\n  return { clicked: false, reason: 'not-found' }\n}\n/home/runner/work/_temp/omgithub-runtime/scripts/default-capture.mjs:31:      selector: process.env.CAPTURE_START_SELECTOR || ''\n/home/runner/work/_temp/omgithub-runtime/scripts/default-capture.mjs:33:    console.log(`Capture ${name}: auto-start ${start.clicked ? 'clicked' : start.reason}`)\n/home/runner/work/_temp/omgithub-runtime/scripts/capture-start.test.mjs:52:      if (process.env.CAPTURE_TEST_DIR) await page.screenshot({ path: `${process.env.CAPTURE_TEST_DIR}/auto-start-${width}.png` })\n"}],"metadata":{"status":"completed","truncated":false,"exit":0}},"time":{"created":1793936096255,"ran":1793936097365,"completed":1793936097547}}],"snapshot":{"start":"a08ec82db67fa8259ff81bab6587d4c1e4cf34e0","end":"a08ec82db67fa8259ff81bab6587d4c1e4cf34e0","files":[]},"finish":"tool-calls","rawFinish":"tool_calls","cost":0,"tokens":{"input":2325,"output":86,"reasoning":2130,"cache":{"read":30464,"write":0}}},{"id":"msg_1aeec811f001He5ly8BngxK5ZH","time":{"created":1793936097572,"streamed":1793936108294,"completed":1793936108303},"type":"assistant","agent":"build","model":{"id":"deepseek-v4.1-flash-free","providerID":"opencode","variant":"default"},"content":[{"type":"reasoning","text":"Button text must exactly \"Start\" or \"Play\" to auto-click. We'll